doctype html
html(lang='en')
  head
    include ../includes/head.pug
  body
    a.skip-link(href='#main') Skip to content
    if (nconf.get('html:theme') === 'memphis')
      include ../includes/decorations.pug
    include ../includes/header.pug
    main#main(role='main')
      block content
    include ../includes/footer.pug
