extends ./layouts/default.pug

block content
  section.section
    .container
      h1.sr-only Run a web performance test
      .level
        .level-item.has-text-centered
          img(src=nconf.get('html:logo:path') width=nconf.get('html:logo:width') alt=nconf.get('html:logo:alt'))

      if serverConfig.length > 0
        script(src='/js/index-tabs.js?v=' + assetVersion)

        .tabs.is-centered.is-boxed.is-medium(role='tablist' aria-label='Test configuration')
          button.tab.is-active(role='tab' type='button' id='tab-settings' aria-selected='true' aria-controls='settings' tabindex='0' data-open-tab='settings') #{getText('index.tab.settings')}
          button.tab(role='tab' type='button' id='tab-commandline' aria-selected='false' aria-controls='commandline' tabindex='-1' data-open-tab='commandline') #{getText('index.tab.cli')}
          button.tab(role='tab' type='button' id='tab-extras' aria-selected='false' aria-controls='extras' tabindex='-1' data-open-tab='extras') #{getText('index.tab.extras')}
          if isScriptingAllowed(false)
            button.tab(role='tab' type='button' id='tab-scripting' aria-selected='false' aria-controls='scripting' tabindex='-1' data-open-tab='scripting') #{getText('index.tab.scripting')}

        form#analyze-form(method='post' action='/')
          .content-tab#settings(role='tabpanel' aria-labelledby='tab-settings')
            include includes/index/tabs/settings.pug
          .content-tab#extras(role='tabpanel' aria-labelledby='tab-extras' hidden)
            include includes/index/tabs/extras.pug
          .content-tab#commandline(role='tabpanel' aria-labelledby='tab-commandline' hidden)
            include includes/index/tabs/commandLine.pug
          if isScriptingAllowed(false)
            .content-tab#scripting(role='tabpanel' aria-labelledby='tab-scripting' hidden)
              include includes/index/tabs/scripting.pug
            
      else
        .level
          .level-item.has-text-centered
            p.control.is-expanded
              label.label.is-medium
                | #{getText('index.waitingtestrunners')}
        .level
          .level-item.has-text-centered
            a.button.is-primary.is-medium(href='') #{getText('index.refresh')}
      include ./includes/script.pug