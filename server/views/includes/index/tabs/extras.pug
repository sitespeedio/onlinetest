mixin radio(label, name, hint)
    .control
      input(type='checkbox' name=name id=name aria-describedby=(hint ? name + '-hint' : null))
      .checkbox-text
        label.checkbox.label.is-normal(for=name) #{label}
        if hint
          small.field-hint(id=name + '-hint') #{hint}

.field.is-grouped
    p.control.is-expanded
        label.sr-only(for='label-input') Optional label for this test
        input.input.is-medium#label-input(type='text' placeholder=getText('index.tab.extras.labelplaceholder') name='label' maxlength='100')
    p.control
        button.button.is-primary.is-medium(accesskey='s' id='submittest' type='submit')
            | #{getText('index.button.analyze')}
            kbd ⌘↵

fieldset.field.extras-fieldset
    legend.label Diagnostics to include
    +radio(getText('index.tab.extras.sustainable'),'sustainable')
    +radio(getText('index.tab.extras.axe'),'axe')
    +radio(getText('index.tab.extras.crux'),'crux', getText('index.tab.extras.cruxhint'))
    if (nconf.get('html:useLighthouse') === true)
      +radio(getText('index.tab.extras.lighthouse'),'lighthouse')
