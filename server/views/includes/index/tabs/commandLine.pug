.field.is-grouped
    p.control.is-expanded
        label.sr-only(for='commandlinearea') #{getText('index.tab.cli.addargs')}
        textarea.textarea.is-medium(placeholder=getText('index.tab.cli.placeholder') name='extras' id='commandlinearea' spellcheck='false' aria-describedby='cli-help-line')
    p.control
        button.button.is-primary.is-medium(accesskey='s' id='submittest' type='submit')
            | #{getText('index.button.analyze')}
            kbd ⌘↵
p.help-line#cli-help-line
    | #{getText('index.tab.cli.addargs')} —
    |
    a.ext-link(href='https://www.sitespeed.io/documentation/sitespeed.io/configuration/#the-options' target='_blank' rel='noopener noreferrer') #{getText('index.tab.cli.clioptions')}

.cli-picker(aria-labelledby='cli-picker-label')
    .cli-picker-head
      label.cli-picker-label#cli-picker-label(for='cli-search') Insert option
      input.cli-search#cli-search(type='search' placeholder='Filter sitespeed.io options…' aria-label='Filter CLI options' autocomplete='off')
      span.cli-picker-status(role='status' aria-live='polite' id='cliResultCount')
    ul.cli-list#cliList(aria-label='Available CLI options')
      li.cli-empty Click the Command line tab to load options…

script(src='/js/commandline.js?v=' + assetVersion)
