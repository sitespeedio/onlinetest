mixin dropdown(label, name)
  .mb-2.mb-tablet-0
    label.label.is-normal(for=name) #{label}
    .select.is-normal.is-fullwidth
      select(id=name name=name)
        block

block content
    .field.is-grouped
        p.control.is-expanded
            label.sr-only(for='url') URL to test
            input.input.is-medium(type='url' inputmode='url' placeholder=getText('index.tab.settings.placeholder', testDomains) name='url' id='url' autofocus required aria-required='true' autocomplete='url' autocapitalize='off' spellcheck='false')
        p.control
            button.button.is-primary.is-medium(accesskey='s' id='submittest' type='submit')
              | #{getText('index.button.analyze')}
              kbd ⌘↵

    .level
        +dropdown(getText('index.tab.settings.location') ,'location')
            each setup in serverConfig
                option(value=setup.name) #{setup.name}

        +dropdown(getText('index.tab.settings.testtype'),'testType')
            - testTypes = {}
            each setup in serverConfig[0].setup
                - testTypes[setup.type] = 1
            each val, key in testTypes
                if (key === 'emulatedMobile')
                    option(value=key) #{getText('index.tab.settings.emulatedmobile')}
                else
                    option(value=key) #{key}

        +dropdown(getText('index.tab.settings.browser'),'browser')
            each browser in serverConfig[0].setup[0].browsers
                option(value=browser) #{browser}

    .level
        +dropdown(getText('index.tab.settings.connectivity'),'connectivity')
            each connectivity in  serverConfig[0].setup[0].connectivity
                option(value=connectivity) #{connectivity}

        +dropdown(getText('index.tab.settings.device'),'deviceId')
            if (serverConfig[0].setup[0].type === 'android')
                each setup in serverConfig[0].setup
                    if setup.deviceId
                        option(value=setup.deviceId) #{setup.deviceId} (#{queueNamesAndSize[setup.queue]})

        +dropdown(getText('index.tab.settings.iterations'),'iterations')
            option 1
            option(selected='selected') 3
            option 5
            option 7
            option 9
            option 11
            option 15
            option 21

    //- Repopulate testType/browser/connectivity/device when location changes.
    //- The server-rendered defaults match serverConfig[0].setup[0]; without
    //- this, picking a second location leaves the dependent dropdowns showing
    //- the first location's options and validateQueue rejects the submission.
    script(type='application/json' id='locations-data')!= JSON.stringify({locations: serverConfig, queueSizes: queueNamesAndSize, labels: {emulatedMobile: getText('index.tab.settings.emulatedmobile')}}).replace(/</g, '\\u003c')
    script(src='/js/settings.js?v=' + assetVersion)
