script(src='/js/scripting-loader.js?v=' + serverVersion)

.field.is-grouped
    p.control.is-expanded
        label.sr-only(for='scriptingName') Script name
        input.input.is-medium(type='text' placeholder=getText('index.tab.scripting.scriptname') name='scriptingName' id='scriptingName' pattern='^[-a-zA-Z0-9\._-]*')
    p.control
        button.button.is-primary.is-medium(accesskey='s' id='submittest' type='submit')
            | #{getText('index.button.analyze')}
            kbd ⌘↵

p.control.is-expanded
    label.label.is-normal.is-white
        | #{getText('index.tab.scripting.recommendation')} (
        a.ext-link(href='https://www.sitespeed.io/documentation/sitespeed.io/scripting/' target='_blank' rel='noopener noreferrer') #{getText('index.tab.scripting.documentation')}
        | )

.field.is-grouped
    #editor(style='height: 400px; width: 100%;')
    textarea(name='scripting' id='hiddenScriptingArea' style='display:none;')

include editor
