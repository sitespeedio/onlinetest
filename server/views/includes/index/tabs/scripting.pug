script(type='text/javascript').
    // Tiny on-demand loader for the Ace editor (~600 KB of JS).
    // Triggered only when the user opens the Scripting tab.
    window.__loadAceEditor = (function () {
      var loaded = false, loading = null;
      function loadScript(src) {
        return new Promise(function (resolve, reject) {
          var s = document.createElement('script');
          s.src = src; s.onload = resolve; s.onerror = reject;
          document.head.appendChild(s);
        });
      }
      return function () {
        if (loaded) return Promise.resolve();
        if (loading) return loading;
        loading = loadScript('/js/ace-1.33.1/ace.js')
          .then(function () {
            ace.config.set('basePath', '/js/ace-1.33.1/');
            return Promise.all([
              loadScript('/js/ace-1.33.1/theme/theme-github.js'),
              loadScript('/js/ace-1.33.1/ext-language_tools.js'),
              loadScript('/js/ace-1.33.1/mode-javascript.js')
            ]);
          })
          .then(function () {
            loaded = true;
            if (typeof window.__initAceEditor === 'function') window.__initAceEditor();
          });
        return loading;
      };
    })();

.field.is-grouped
    p.control.is-expanded
        label.sr-only(for='scriptingName') Script name
        input.input.is-medium(type='text' placeholder=getText('index.tab.scripting.scriptname') name='scriptingName' id='scriptingName' pattern='^[-a-zA-Z0-9\._-]*')
    p.control
        button.button.is-primary.is-medium(accesskey='s' id='submittest' type='submit')
            | #{getText('index.button.analyze')}
            kbd ⌘↵

p.control.is-expanded
    label.label.is-normal.is-white
        | #{getText('index.tab.scripting.recommendation')} (
        a.ext-link(href='https://www.sitespeed.io/documentation/sitespeed.io/scripting/' target='_blank' rel='noopener noreferrer') #{getText('index.tab.scripting.documentation')}
        | )

.field.is-grouped
    #editor(style='height: 400px; width: 100%;')
    textarea(name='scripting' id='hiddenScriptingArea' style='display:none;')

include editor
