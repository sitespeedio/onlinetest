extends ./layouts/default.pug

block content
  section.section
    .container
      h1.sr-only Page not found
      .four-oh-four(aria-hidden='true')
        span.digit 4
        span.sep ·
        span.digit 0
        span.sep ·
        span.digit 4
      p.page-not-found Page not found
      p.lost-msg
        | Try the
        |
        a(href='/') start page
        |
        | or
        |
        a(href='/search/') search the archive
        | .
      p.has-text-centered
        a.button.is-primary.is-medium(href='/') #{getText('index.button.backtostart')}
